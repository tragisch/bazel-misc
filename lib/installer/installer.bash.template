# Installs files built by bazel.
#
@@GENERATED_WARNING@@
#
# 1.  To use this template, add installer() rule from installer/def.bzl
#     to your BUILD file.
# 2.  To install the target:
#     bazel run //path/to/your:installer_target                    # Uses default: workspace_root/dist/target_name
#     bazel run //path/to/your:installer_target -- /custom/path    # Uses custom path
#     bazel run //path/to/your:installer_target -- -s /usr/local   # Uses sudo

set -o pipefail -o errexit -o nounset

# Fallback: set RUNFILES_DIR if not provided by Bazel
if [[ -z "${RUNFILES_DIR:-}" ]]; then
  RUNFILES_DIR="$0.runfiles"
fi

# --- begin runfiles.bash initialization v2 ---
# Copy-pasted from the Bazel Bash runfiles library v2.
f=bazel_tools/tools/bash/runfiles/runfiles.bash
source "${RUNFILES_DIR:-/dev/null}/$f" 2>/dev/null || \
  source "$(grep -sm1 "^$f " "${RUNFILES_MANIFEST_FILE:-/dev/null}" | cut -f2- -d' ')" 2>/dev/null || \
  source "$0.runfiles/$f" 2>/dev/null || \
  source "$(grep -sm1 "^$f " "$0.runfiles_manifest" | cut -f2- -d' ')" 2>/dev/null || \
  source "$(grep -sm1 "^$f " "$0.exe.runfiles_manifest" | cut -f2- -d' ')" 2>/dev/null || \
  { echo>&2 "ERROR: cannot find $f"; exit 1; }; f=;
# --- end runfiles.bash initialization v2 ---

# Template variables:
# Array of paths of files
declare -r -a SOURCE_FILES=@@SOURCE_FILES@@
# Path to license JSON file (if available)
declare -r LICENSE_JSON="@@LICENSE_JSON@@"
declare -a TARGET_NAMES
declare -r -a TARGET_NAMES_ORIG=@@TARGET_NAMES@@
for name in "${TARGET_NAMES_ORIG[@]}"; do
  case "$name" in
    *.a|*.so|*.dylib) TARGET_NAMES+=("lib/${name##*/}") ;;
    *.h)              TARGET_NAMES+=("include/${name##*/}") ;;
    # Check if it's a binary file (executable without extension or with binary extensions)
    *.exe|*.[Bb]in|*.[Aa]pp)
                      TARGET_NAMES+=("bin/${name##*/}") ;;
    *)
      # For files without extension, check if they are likely binaries
      basename="${name##*/}"
      if [[ "$basename" == *"."* ]]; then
        # Has extension but not a known library/header -> likely asset/data file
        TARGET_NAMES+=("${basename}")
      else
        # No extension -> likely a binary executable
        TARGET_NAMES+=("bin/${basename}")
      fi
      ;;
  esac
done
# Set executable mode of files
declare -r EXECUTABLE=@@EXECUTABLE@@
# Fully specified bazel label of INSTALLER_LABEL installer() rule.
declare -r INSTALLER_LABEL=@@INSTALLER_LABEL@@
declare -r SYSTEM_INTEGRATION=@@SYSTEM_INTEGRATION@@
# Number of files.
declare -r -i N_FILES="${#SOURCE_FILES[@]}"

# Target name provided by Bazel
declare -r TARGET_NAME=@@TARGET_NAME@@

# Debug mode - can be enabled via environment variable
declare -r INSTALLER_DEBUG="${INSTALLER_DEBUG:-false}"

function debug() {
  [[ "$INSTALLER_DEBUG" == "true" ]] && echo >&2 "DEBUG: $@"
  return 0
}

function error() {
  echo >&2 "installer.bash ERROR: $@"
  usage
  exit 1
}

function safe_copy() {
  local source="$1" target="$2" sudo="$3"
  if ! $sudo cp -- "$source" "$target"; then
    error "Failed to copy $source to $target"
  fi
}

function safe_copy_warn() {
  local source="$1" target="$2" sudo="$3"
  $sudo cp -- "$source" "$target" 2>/dev/null
}

function safe_chmod() {
  local mode="$1" target="$2" sudo="$3"
  if ! $sudo chmod "$mode" "$target"; then
    error "Failed to set permissions $mode on $target"
  fi
}

function safe_chmod_warn() {
  local mode="$1" target="$2" sudo="$3"
  $sudo chmod "$mode" "$target" 2>/dev/null
}

function usage() {
  echo >&2 "Usage: bazel run ${INSTALLER_LABEL} [-c opt] [--] [-s] [--] [INSTALL_PREFIX]"
  echo >&2 ""
  echo >&2 "  INSTALL_PREFIX   Optional installation path (default: workspace_root/dist/${TARGET_NAME})"
  echo >&2 "  -s               Use sudo for installation"
  echo >&2 "  -h               Show this help"
  echo >&2 ""
  echo >&2 "Examples:"
  echo >&2 "  bazel run ${INSTALLER_LABEL}                    # Install to dist/${TARGET_NAME}"
  echo >&2 "  bazel run ${INSTALLER_LABEL} -- /usr/local      # Install to /usr/local/${TARGET_NAME}"
  echo >&2 "  bazel run ${INSTALLER_LABEL} -- -s /usr/local   # Install with sudo"
}

# Get workspace root directory
function get_workspace_root() {
  # Start from current directory and walk up to find MODULE.bazel or WORKSPACE
  local dir="$(pwd)"
  
  # If we're in a Bazel execroot, try to find the real workspace
  if [[ "$dir" == *"/execroot/"* ]]; then
    # Get the BUILD_WORKSPACE_DIRECTORY if available (when run with bazel run)
    if [[ -n "${BUILD_WORKSPACE_DIRECTORY:-}" ]] && [[ -d "$BUILD_WORKSPACE_DIRECTORY" ]]; then
      echo "$BUILD_WORKSPACE_DIRECTORY"
      return 0
    fi
  fi
  
  # Walk up directory tree to find workspace root
  while [[ "$dir" != "/" ]]; do
    if [[ -f "$dir/MODULE.bazel" ]] || [[ -f "$dir/WORKSPACE" ]] || [[ -f "$dir/WORKSPACE.bazel" ]]; then
      echo "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  
  # Fallback to current directory
  echo "$(pwd)"
}

# Checks that all template variables have been substituted.
function verify_templates() {
  if [[ "${SOURCE_FILES[@]:0:2}" =~ ^@@ ]] ||
    [[ "${TARGET_NAMES[@]:0:2}" =~ ^@@ ]] ||
    [[ "${INSTALLER_LABEL:0:2}" =~ ^@@ ]]; then
    error "template substitution failed"
  fi

  if [[ "${#SOURCE_FILES[@]}" != "${#TARGET_NAMES[@]}" ]]; then
    error "the number of source files is different thant the number target names"
  fi
}

# Checks that each path in $SOURCE_FILES[@] is a readable file.
function check_sources() {
  for source in "${SOURCE_FILES[@]}"; do
    resolved="$(rlocation ${source})"
    if ! [[ -r "${resolved}" ]]; then
      error "Can't read '${source}' resolved to '${resolved}'"
    fi
  done
}

# Installs $i-th file in $prefix.
function install_file() {
  local prefix="$1"
  local i="$2"
  local sudo="$3"
  # Silent installation - only show final summary
  local source="$(rlocation ${SOURCE_FILES[${i}]})"
  local target="${TARGET_NAMES[${i}]}"
  local target_dir
  target_dir="$(dirname -- "${prefix}/${target}")"
  local target_name
  target_name="$(basename -- "${target}")"
  local target_mode
  if [[ "${EXECUTABLE}" = "True" ]]; then
    target_mode=755
  else
    target_mode=644
  fi

  [[ -d "${target_dir}" ]] || \
    $sudo mkdir -p "${target_dir}"

  # Use safe_copy for better error handling
  # Remove existing target file to avoid macOS creating " 2" copies
  if [[ -f "${target_dir}/${target_name}" ]]; then
    $sudo rm -f "${target_dir}/${target_name}"
  fi
  safe_copy "${source}" "${target_dir}/${target_name}" "$sudo"
  safe_chmod "${target_mode}" "${target_dir}/${target_name}" "$sudo"
}

# Function to install licenses from JSON (disabled - license integration deactivated)
function install_licenses_from_json() {
  local prefix="$1"
  local sudo="$2"
  
  debug "License integration disabled"
  return 0
}

function main() {
  verify_templates

  local g_flag=''
  local s_flag=''
  local show_help=false
  
  while getopts ':ghs' flag; do
    case "${flag}" in
      g) g_flag='' ;;  # Ignored - debug builds flag
      s) s_flag='sudo' ;;  # Run with sudo
      h) show_help=true ;;
      *) error "Unexpected option '-${OPTARG}'"   ;;
    esac
  done

  if [[ "$show_help" == true ]]; then
    usage
    exit 0
  fi

  local prefix
  if [[ -z "${OPTIND:-}" ]] || (($OPTIND > $#)); then
    # No install prefix provided - use default
    local workspace_root="$(get_workspace_root)"
    prefix="${workspace_root}/dist/${TARGET_NAME}"
    # Remove verbose output - only show final summary
  else
    prefix="${!OPTIND}"
    
    # Convert Windows path to Unix path
    if command -v cygpath &> /dev/null; then
      prefix="$(cygpath $prefix)"
    fi

    if [[ "${prefix:0:1}" != "/" ]] && [[ "${prefix:0:1}" != "." ]]; then
      error "INSTALL_PREFIX must be an absolute path or relative path starting with '.'"
    fi
    
    # Add target name as subdirectory
    prefix="${prefix}/${TARGET_NAME}"
    echo "Installing to: ${prefix}"
  fi

# Install licenses from rules_license JSON
install_licenses_from_json "$prefix" "$s_flag"

check_sources
  local i
  for ((i=0; i<${N_FILES}; i++)); do
    install_file "${prefix}" "${i}" "${s_flag}"
  done

  if [[ "${SYSTEM_INTEGRATION}" == "True" ]]; then
    echo "Creating symlinks in standard system directories..."

    if [[ -d "${prefix}/bin" ]]; then
      for binfile in "${prefix}/bin/"*; do
        [[ -e "$binfile" ]] || continue
        target="/usr/local/bin/$(basename "$binfile")"
        echo "Linking $binfile → $target"
        ${s_flag} ln -sf "$binfile" "$target"
      done
    fi

    if [[ -d "${prefix}/lib" ]]; then
      for libfile in "${prefix}/lib/"*; do
        [[ -e "$libfile" ]] || continue
        target="/usr/local/lib/$(basename "$libfile")"
        echo "Linking $libfile → $target"
        ${s_flag} ln -sf "$libfile" "$target"
      done
    fi

    if [[ -d "${prefix}/include" ]]; then
      for header in "${prefix}/include/"*; do
        [[ -e "$header" ]] || continue
        target="/usr/local/include/$(basename "$header")"
        echo "Linking $header → $target"
        ${s_flag} ln -sf "$header" "$target"
      done
    fi
  fi

  # ANSI color codes for green text like Bazel
  local green='\033[0;32m'
  local reset='\033[0m'
  
  echo ""
  echo -e "${green}INFO:${reset} Installation completed successfully"
  echo -e "${green}INFO:${reset} Installed to: ${prefix}"
  if [[ -d "${prefix}/bin" ]]; then
    echo -e "${green}INFO:${reset} Binaries: ${prefix}/bin/"
  fi
  if [[ -d "${prefix}/lib" ]]; then
    echo -e "${green}INFO:${reset} Libraries: ${prefix}/lib/"
  fi
  if [[ -d "${prefix}/include" ]]; then
    echo -e "${green}INFO:${reset} Headers: ${prefix}/include/"
  fi
  # Count and display summary of other files (assets, configs, etc.)
  other_files=$(find "${prefix}" -type f ! -path "${prefix}/bin/*" ! -path "${prefix}/lib/*" ! -path "${prefix}/include/*" 2>/dev/null | wc -l | tr -d ' ')
  if [[ "$other_files" -gt 0 ]]; then
    echo -e "${green}INFO:${reset} Assets: ${other_files} additional files"
  fi
}

main "$@"
exit 0
